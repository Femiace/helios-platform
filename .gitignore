# --- Credentials and signing material. Never relax this block. ---
*.snk
*.pfx
*.p12
*.key
*.pem
local.settings.json
appsettings.Development.json
appsettings.Local.json
.env
.env.*
secrets/
credentials.*
helios-credentials.*

# --- .NET build output ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.pdb
*.cache

# --- NuGet ---
*.nupkg
*.snupkg
packages/
.nuget/

# --- Node and PCF ---
node_modules/
out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pcfproj.user

# --- Azure Functions local runtime ---
.azurefunctions/
__azurite_db*__.json
__blobstorage__/
__queuestorage__/

# --- Build artifacts, not source ---
# Exported and packed solution zips are outputs. Source is the unpacked folder.
artifacts/
*.zip

# --- OS and editor noise ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# --- VS Code: keep shared config, drop personal state ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
