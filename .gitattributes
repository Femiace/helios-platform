* text=auto

*.cs      text diff=csharp
*.ts      text
*.tsx     text
*.json    text
*.xml     text
*.yml     text
*.yaml    text
*.md      text
*.resx    text
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.sh      text eol=lf

*.msapp   binary
*.zip     binary
*.dll     binary
*.pdb     binary
*.snk     binary
*.pfx     binary
*.png     binary
*.jpg     binary
*.gif     binary
*.ico     binary
# --- Web resources and client-side source ---
*.js      text
*.jsx     text
*.css     text
*.html    text
*.svg     text

# --- Project and solution files ---
*.sln     text eol=crlf
*.csproj  text
*.cdsproj text
*.pcfproj text
*.props   text
*.targets text

# --- Generated solution source ---
# Unpacked solutions are produced by pac, not written by hand. Excluding them
# from GitHub language statistics keeps C# and TypeScript visible on the
# repository page. They stay fully diffable, just collapsed by default.
solutions/** linguist-generated=true
